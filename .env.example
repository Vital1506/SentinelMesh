# SentinelMesh service binding (0.0.0.0 only in an isolated lab / VM / container)
SENTINELMESH_LISTEN_HOST=0.0.0.0

# Non-privileged decoy ports for a normal user / container runtime
SENTINELMESH_HTTP_PORT=8080
SENTINELMESH_FTP_PORT=2121
SENTINELMESH_SMTP_PORT=2525
SENTINELMESH_SSH_PORT=2222

# Analyst console (keep 127.0.0.1 unless you add auth / reverse proxy in front)
SENTINELMESH_DASHBOARD_HOST=127.0.0.1
SENTINELMESH_DASHBOARD_PORT=8000
SENTINELMESH_DASHBOARD_REFRESH_SECONDS=10

# Instance metadata
SENTINELMESH_INSTANCE_NAME=SentinelMesh // Lab Node 01
SENTINELMESH_ENVIRONMENT=lab

# Local artifact directories
SENTINELMESH_DATA_DIR=./data
SENTINELMESH_REPORTS_DIR=./reports
SENTINELMESH_MODEL_DIR=./models
SENTINELMESH_INTEL_CACHE_TTL_SECONDS=1800

# REQUIRED for non-lab environments: analyst console auth token
# In lab/demo mode the token may be empty, but leave it set for anything real.
SENTINELMESH_TELEMETRY_TOKEN=
SENTINELMESH_TELEMETRY_TOKEN_HEADER=X-SentinelToken

# Optional CTI provider API keys (fill before relying on external enrichment)
ABUSEIPDB_API_KEY=
ALIENVAULT_OTX_API_KEY=
SHODAN_API_KEY=
VT_API_KEY=

# Honeypot service toggles
SENTINELMESH_ENABLE_SSH=1
SENTINELMESH_ENABLE_HTTP=1
SENTINELMESH_ENABLE_FTP=1
SENTINELMESH_ENABLE_SMTP=1

# Optional: re-enable ``# next likely command`` hints in shell responses.
# Useful for demos/training, less ideal for live deception.
SENTINELMESH_SHELL_LEAK_PREDICTIONS=0
